# ============================================================
# 🍊 TỔ CAM - Backend Environment Variables
# File này CHỈ dùng local hoặc cấu hình trên Railway Dashboard
# ============================================================

# --- Casso Webhook Secret ---
# Lấy từ: https://casso.vn > Dashboard > Webhook > Secret Key
CASSO_SECRET=your_casso_secret_here

# --- SePay API Key (Tùy chọn) ---
SEPAY_API_KEY=your_sepay_api_key_here

# --- Thông tin tài khoản ngân hàng ---
ACCOUNT_NUMBER=2027022007

# --- Locket API (Cụ Cam) ---
# Lấy từ: https://locket.2707226.xyz/dashboard?tab=docs (Mã API > Tạo Secret Token)
# Bắt đầu bằng sk_... — KHÔNG chia sẻ, không đưa vào Git!
LOCKET_SECRET_KEY=sk_your_secret_key_here

# Base URL của Locket API (giữ nguyên nếu không đổi domain)
LOCKET_API_BASE=https://locket.2707226.xyz

# Mã gói tương ứng chuẩn 1:1 với Cụ Cam:
# Gói 1 ngày: LKGT3D (1 coin)
# Gói 6 tháng: LKG6M (8 coin)
# Gói 1 năm: LKG1Y (15 coin)
# Gói Vĩnh Viễn: LKGVV (31 coin)
LOCKET_PACKAGE_TEST=LKGT3D
LOCKET_PACKAGE_6MONTH=LKG6M
LOCKET_PACKAGE_YEARLY=LKG1Y
LOCKET_PACKAGE_LIFETIME=LKGVV
